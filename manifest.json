{
  "manifest_version": 3,
  "name": "DOM Feedback",
  "version": "1.0.0",
  "description": "Comment on page elements and copy the feedback as JSON for an AI agent.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle DOM Feedback (Alt+Shift+F)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" }
    }
  }
}
